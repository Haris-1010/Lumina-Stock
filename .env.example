# Supabase: copy the exact host from the project's Connect dialog.
# URL-encode special characters in the database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Session pooler for Prisma schema operations (never use transaction mode here).
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="https://YOUR_PROJECT.vercel.app"
NEXT_PUBLIC_APP_DOMAIN="YOUR_PROJECT.vercel.app"
# Optional platform owner access, comma-separated emails.
ENTERPRISE_ADMIN_EMAILS=""
